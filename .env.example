# Copy this file to .env.prod on the server. Never commit real secrets.
ONEBOT_ACCESS_TOKEN=replace-with-onebot-token
SUPERUSERS=["123456789"]

UPTIME_TOKEN=replace-with-a-long-random-token
JIHUANSHE_TOKEN=replace-with-a-fresh-token
API_TIMEOUT=120.0
PARSER_DISABLED_PLATFORMS=["twitter", "douyin"]

# Optional deployment-specific integration settings.
CARDRUSH_PROXY_URL=socks5h://127.0.0.1:1080
PUBLIC_GROUP_ID=123456789
JM_DATA_DIR=/srv/hikari-bot-data/jm
JM_PDF_PASSWORD=replace-with-a-password

# NAS LAN power control. These commands only accept private messages from
# existing SUPERUSERS.
NAS_POWER_URL=https://power.nas.xyk.one
NAS_POWER_TOKEN=replace-with-the-lan-control-token
NAS_POWER_TIMEOUT=15.0

# OCG Ruling Assistant API. The default points to the upstream public service;
# set this to your self-hosted /api/answer URL when one is available.
RULING_ASSISTANT_API_URL=https://ocg-ruling-assistant.vercel.app/api/answer
RULING_ASSISTANT_TIMEOUT=310.0

# LM Studio local model. Only SUPERUSERS who @ the bot in an allowed group can use it.
LOCAL_LLM_API_BASE_URL=http://192.168.0.100:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3.5-9b
# LM Studio has API token authentication enabled; set its token only in .env.prod.
LOCAL_LLM_API_KEY=replace-with-your-lm-studio-api-token
LOCAL_LLM_TIMEOUT=180.0
LOCAL_LLM_IMAGE_MAX_COUNT=4
LOCAL_LLM_IMAGE_MAX_BYTES=10485760
# LOCAL_LLM_SYSTEM_PROMPT=你是一个有帮助的游戏王机器人助手。
