# Copy this file to .env.prod on the server. Never commit real secrets.
ONEBOT_ACCESS_TOKEN=replace-with-onebot-token
SUPERUSERS=["123456789"]

UPTIME_TOKEN=replace-with-a-long-random-token
JIHUANSHE_TOKEN=replace-with-a-fresh-token
API_TIMEOUT=120.0
PARSER_DISABLED_PLATFORMS=["twitter", "douyin"]

# Optional deployment-specific integration settings.
CARDRUSH_PROXY_URL=socks5h://127.0.0.1:1080
PUBLIC_GROUP_ID=123456789
JM_DATA_DIR=/srv/hikari-bot-data/jm
JM_PDF_PASSWORD=replace-with-a-password

# NAS LAN power control. These commands only accept private messages from
# existing SUPERUSERS.
NAS_POWER_URL=https://power.nas.xyk.one
NAS_POWER_TOKEN=replace-with-the-lan-control-token
NAS_POWER_TIMEOUT=15.0
