{
  "features": {
    "effect": {
      "label": "效果卡片",
      "coverage": "卡名、日文名/读音、类型数值、灵摆与效果；保留完整原数据"
    },
    "art": {
      "label": "卡图与查询反馈",
      "coverage": "逐张卡图、页码、上一张/下一张与主按钮；图像来源不变"
    },
    "price": {
      "label": "卡价与版本",
      "coverage": "罕贵/版本列表、人民币集换社价格、日元 Cardrush 收取价、日版与错误状态；匹配和品相规则不变"
    },
    "common": {
      "label": "帮助与查询入口",
      "coverage": "帮助、ping、卡密、卡组网页入口和查询错误"
    },
    "paging": {
      "label": "长输出与续读",
      "coverage": "完整长文本分页、继续提示、过期与平台拒绝提示"
    },
    "preview": {
      "label": "格式预览",
      "coverage": "原格式预览命令和其按钮"
    },
    "callback": {
      "label": "回调反馈",
      "coverage": "过期、重复、ACK 失败提示；权限/动作和安全码不允许编辑"
    },
    "unsupported": {
      "label": "尚未实现",
      "coverage": "没有多候选选卡列表、独立版本选择按钮、群输出或主动推送；不伪造可编辑功能",
      "unsupported": true
    }
  },
  "states": {
    "effect.card": {
      "feature": "effect",
      "label": "效果卡片",
      "template": "# {name}\n{official}\n\n**{types}**\n\n{pendulum}## 效果\n{effect}",
      "fields": {
        "name": "卡名",
        "official": "日文名与已有读音",
        "types": "类型/属性/数值",
        "pendulum": "完整灵摆段落",
        "effect": "完整效果原文"
      },
      "samples": {
        "name": "灰流うらら",
        "official": "示例值",
        "types": "示例值",
        "pendulum": "示例值",
        "effect": "示例值"
      },
      "mode": "markdown",
      "buttons": {
        "image": "查看卡图",
        "price": "查询卡价"
